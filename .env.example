# ─── Lotería de Animales — Frontend ─────────────────────────────────────────
# Copiar este archivo como .env.local para desarrollo local
# En producción usar .env.production

# URL base de la API WordPress (sin trailing slash)
# Desarrollo local (Local by Flywheel):
NEXT_PUBLIC_API_URL=http://loteria-animales.local/wp-json/la/v1
# Staging:
# NEXT_PUBLIC_API_URL=https://backoffice.187.77.251.126.nip.io/wp-json/la/v1
# Producción:
# NEXT_PUBLIC_API_URL=https://api.loteriadeanimales.com.py/wp-json/la/v1

# URL pública del sitio (sin trailing slash) — usada en JSON-LD y metadatos OG
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Producción: NEXT_PUBLIC_SITE_URL=https://loteriadeanimales.com.py

# Número WhatsApp para el botón flotante (formato internacional sin +)
NEXT_PUBLIC_WHATSAPP_NUMBER=595XXXXXXXXX

# ─── Webhook ISR: Next.js ↔ WordPress ────────────────────────────────────────
# Token secreto para el endpoint POST /api/revalidate.
# WordPress envía este valor en el header HTTP: x-revalidate-secret: <VALOR>
# cuando publica/actualiza un sorteo, pálpite o página institucional.
#
# DEBE coincidir exactamente con LA_REVALIDATE_SECRET en wp-config.php:
#   define( 'LA_REVALIDATE_SECRET', '<MISMO VALOR QUE AQUI>' );
#   define( 'LA_NEXTJS_URL',        'https://loteriadeanimales.com.py' );
#
# Generar un valor seguro con:
#   openssl rand -hex 32
#
# NUNCA anteponer NEXT_PUBLIC_ — esta variable es PRIVADA (solo server-side).
REVALIDATE_SECRET=cambia_esto_por_un_hash_seguro_de_64_chars
